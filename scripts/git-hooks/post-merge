#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"
test -d public_html/wp-content
test -f public_html/wp-load.php

source_file=deploy/petrini-deploy-check.txt
target_file=public_html/petrini-deploy-check.txt
if [ -L "$target_file" ] || { [ -e "$target_file" ] && [ ! -f "$target_file" ]; }; then
    echo "Destinazione del collaudo non valida" >&2
    exit 1
fi
rsync -i --chmod=F644 -- "$source_file" "$target_file"
echo "Collaudo pubblicato: /petrini-deploy-check.txt"
